# the user's game files and everything unpacked or derived from them
gamefiles/
game/
private/
ppc/
iso_list.txt
*.xex
*.xexp
*.bin
*.iso

# build output
host/build/
host/build_prof/
recomp_check/build/
*.obj
*.exe
*.map
*.pdb

# logs, saves and run output
logs/
saves/
cache/
*.log
build_log*.txt
saves_backup/
saves_complete/
SAVEDATA.DAT
asura_logo*.png
thirdparty/*
!thirdparty/libmspack/
!thirdparty/xexpatch/

# player settings written by the Graphics Options menu
asura.ini

# texture dumps and replacements made from the game (ASURA_MODDUMP, mods/textures)
mods/

# button prompts built from the game's icons (tools\make_prompts.ps1): game art
assets/prompts/

# input recordings of the user's own runs (local test data)
replays/

# release folder made by tools\make_release.ps1 (may hold a test install with game data)
release/

# written by tools\make_release.ps1 for a release build, removed after
host/generated/build_version.h
